70,"rendered":771},{"title":763,"author":613,"datefinished":764,"cover":765},"To Build a Fire","07/01/2025","../../assets/bookcovers/ToBuildAFire.jpg","src/content/books/ToBuildAFire.md",[765],[769],[14],"7a79932c59014aa3",{"html":17,"metadata":772},{"headings":773,"localImagePaths":774,"remoteImagePaths":775,"frontmatter":776,"imagePaths":777},[],[],[],{"title":763,"author":613,"cover":765,"datefinished":764},[],"tuesdayswithmorrie",{"id":778,"data":780,"filePath":785,"assetImports":786,"imageImports":787,"digest":789,"rendered":790},{"title":781,"author":782,"datefinished":783,"cover":784},"Tuesdays with Morrie","Mitch Albom","28/08/2026","../../assets/bookcovers/TuesdaysWithMorrie.jpg","src/content/books/TuesdaysWithMorrie.md",[784],[788],[14],"68e3f75b8bb17e64",{"html":17,"metadata":791},{"headings":792,"localImagePaths":793,"remoteImagePaths":794,"frontmatter":795,"imagePaths":796},[],[],[],{"title":781,"author":782,"cover":784,"datefinished":783},[],"vinlandsagavol1",{"id":797,"data":799,"filePath":804,"assetImports":805,"imageImports":806,"digest":808,"rendered":809},{"title":800,"author":801,"datefinished":802,"cover":803},"Vinland Saga","Makoto Yukimura","09/12/2025","../../assets/bookcovers/VinlandSagaVol1.jpg","src/content/books/VinlandSagaVol1.md",[803],[807],[14],"676e78db72249c6f",{"html":17,"metadata":810},{"headings":811,"localImagePaths":812,"remoteImagePaths":813,"frontmatter":814,"imagePaths":815},[],[],[],{"title":800,"author":801,"cover":803,"datefinished":802},[],"whitefang",{"id":816,"data":818,"filePath":822,"assetImports":823,"imageImports":824,"digest":826,"rendered":827},{"title":819,"author":613,"datefinished":820,"cover":821},"White Fang","25/01/2026","../../assets/bookcovers/WhiteFang.jpg","src/content/books/WhiteFang.md",[821],[825],[14],"2f0b56eff2433b58",{"html":17,"metadata":828},{"headings":829,"localImagePaths":830,"remoteImagePaths":831,"frontmatter":832,"imagePaths":833},[],[],[],{"title":819,"author":613,"cover":821,"datefinished":820},[],"whitenights",{"id":834,"data":836,"filePath":840,"assetImports":841,"imageImports":842,"digest":844,"rendered":845},{"title":837,"author":123,"datefinished":838,"cover":839},"White Nights","31/05/2026","../../assets/bookcovers/WhiteNights.jpg","src/content/books/WhiteNights.md",[839],[843],[14],"dac5e6ab529191c8",{"html":17,"metadata":846},{"headings":847,"localImagePaths":848,"remoteImagePaths":849,"frontmatter":850,"imagePaths":851},[],[],[],{"title":837,"author":123,"cover":839,"datefinished":838},[],"meta::meta",["Map",854,855,856,857,858,859],"astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://vvor.pl\",\"compressHTML\":\"jsx\",\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"dangerouslyProcessSVG\":false,\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"processor\":{\"name\":\"satteri\",\"options\":{\"mdastPlugins\":[],\"hastPlugins\":[],\"features\":{}}}},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"csp\":false,\"actionBodySizeLimit\":1048576,\"serverIslandBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"prerenderConflictBehavior\":\"warn\",\"fetchFile\":\"fetch\",\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"chromeDevtoolsWorkspace\":false,\"incrementalBuild\":false,\"collectionStorage\":\"single-file\"},\"legacy\":{\"collectionsBackwardsCompat\":false}}","astro-version","7.3.8","content-config-digest","15a3adc600e1fd81","projects",["Map",862,863,897,898],"pcapscope",{"id":862,"data":864,"body":866,"filePath":867,"digest":868,"rendered":869},{"title":865},"PCapScope","# Overview\r\n\r\nPCAPScope is a web-based network intrusion detection system (IDS) created as my final year project. The aim was to explore how machine learning could support the analysis of network traffic and help identify flows that may indicate malicious or unusual activity.\r\n\r\nRather than building only a model in a notebook, I developed an entire application that takes packet captures, converts them into meaningful network-flow data, runs anomaly detection, and presents the results through an interactive dashboard.\r\n\r\n## Development\r\n\r\nBefore implementing the system, I had to research several areas of cybersecurity and machine learning. This included learning how intrusion detection systems are designed, how network attacks appear in packet data, and how packet-level information can be aggregated into flows suitable for analysis.\r\n\r\nI also researched the CICIDS2017 dataset and its feature format so that the system could work with recognised network-traffic features such as flow duration, packet counts, packet lengths, inter-arrival times, destination ports, and TCP flags. Understanding these features was important because the quality and consistency of the extracted data directly affects the reliability of the predictions.\r\n\r\n## Challenges and limitations\r\n\r\nI quickly realised that the scope of this project was way bigger than I could handle in a reasonable amount of time. With this in mind, I'd treat this more as a way to get my hands dirty with packets and ids than a full fledged application. \r\n\r\nThe models were trained and designed around the CICIDS2017 dataset. Therefore they look for the traffic patterns, feature distributions and attack types that are present primarily in that dataset. This creates major performance issues when using data from other networks or datasets. This project is better viewed as a demonstration of detection using the CICIDS2017 as a baseline rather a general-purpose IDS.\r\n\r\n## What it does\r\n\r\n- Accepts `.pcap`, `.pcapng`, and pre-extracted `.csv` files.\r\n- Groups TCP and UDP packets into bidirectional flows.\r\n- Extracts CICIDS2017-compatible network features using Scapy.\r\n- Detects anomalous flows with Isolation Forest and Local Outlier Factor.\r\n- Shows anomaly totals, charts, flow-level predictions, and downloadable reports.\r\n- Calculates evaluation metrics when uploaded data contains ground-truth labels.\r\n- Stores previous prediction results so they can be reviewed later.\r\n- Displays these prediction results on a dashboard\r\n\r\n## Basic workflow\r\n\r\n1. A user uploads a packet capture or feature CSV through the Flask dashboard.\r\n2. PCAP files are parsed and divided into flows using active and idle timeout thresholds.\r\n3. Flow features are cleaned, aligned with the training feature set, and standardised.\r\n4. The trained models score each flow using thresholds selected during evaluation.\r\n5. The results are displayed in a dashboard with summary cards, charts, a prediction table, and CSV export.\r\n\r\n## Lessons learned\r\n\r\nThis project helped me understand the challenges of turning a machine learning experiment into a complete application. In particular, I gained practical experience in packet processing, network-flow feature extraction, data preprocessing, anomaly detection, and building a web interface around a machine learning pipeline.","src/content/projects/PCapScope.md","3c12387b90efaf50",{"html":870,"metadata":871},"\u003Ch1 id=\"overview\">Overview\u003C/h1>\n\u003Cp>PCAPScope is a web-based network intrusion detection system (IDS) created as my final year project. The aim was to explore how machine learning could support the analysis of network traffic and help identify flows that may indicate malicious or unusual activity.\u003C/p>\n\u003Cp>Rather than building only a model in a notebook, I developed an entire application that takes packet captures, converts them into meaningful network-flow data, runs anomaly detection, and presents the results through an interactive dashboard.\u003C/p>\n\u003Ch2 id=\"development\">Development\u003C/h2>\n\u003Cp>Before implementing the system, I had to research several areas of cybersecurity and machine learning. This included learning how intrusion detection systems are designed, how network attacks appear in packet data, and how packet-level information can be aggregated into flows suitable for analysis.\u003C/p>\n\u003Cp>I also researched the CICIDS2017 dataset and its feature format so that the system could work with recognised network-traffic features such as flow duration, packet counts, packet lengths, inter-arrival times, destination ports, and TCP flags. Understanding these features was important because the quality and consistency of the extracted data directly affects the reliability of the predictions.\u003C/p>\n\u003Ch2 id=\"challenges-and-limitations\">Challenges and limitations\u003C/h2>\n\u003Cp>I quickly realised that the scope of this project was way bigger than I could handle in a reasonable amount of time. With this in mind, I’d treat this more as a way to get my hands dirty with packets and ids than a full fledged application.\u003C/p>\n\u003Cp>The models were trained and designed around the CICIDS2017 dataset. Therefore they look for the traffic patterns, feature distributions and attack types that are present primarily in that dataset. This creates major performance issues when using data from other networks or datasets. This project is better viewed as a demonstration of detection using the CICIDS2017 as a baseline rather a general-purpose IDS.\u003C/p>\n\u003Ch2 id=\"what-it-does\">What it does\u003C/h2>\n\u003Cul>\n\u003Cli>Accepts \u003Ccode>.pcap\u003C/code>, \u003Ccode>.pcapng\u003C/code>, and pre-extracted \u003Ccode>.csv\u003C/code> files.\u003C/li>\n\u003Cli>Groups TCP and UDP packets into bidirectional flows.\u003C/li>\n\u003Cli>Extracts CICIDS2017-compatible network features using Scapy.\u003C/li>\n\u003Cli>Detects anomalous flows with Isolation Forest and Local Outlier Factor.\u003C/li>\n\u003Cli>Shows anomaly totals, charts, flow-level predictions, and downloadable reports.\u003C/li>\n\u003Cli>Calculates evaluation metrics when uploaded data contains ground-truth labels.\u003C/li>\n\u003Cli>Stores previous prediction results so they can be reviewed later.\u003C/li>\n\u003Cli>Displays these prediction results on a dashboard\u003C/li>\n\u003C/ul>\n\u003Ch2 id=\"basic-workflow\">Basic workflow\u003C/h2>\n\u003Col>\n\u003Cli>A user uploads a packet capture or feature CSV through the Flask dashboard.\u003C/li>\n\u003Cli>PCAP files are parsed and divided into flows using active and idle timeout thresholds.\u003C/li>\n\u003Cli>Flow features are cleaned, aligned with the training feature set, and standardised.\u003C/li>\n\u003Cli>The trained models score each flow using thresholds selected during evaluation.\u003C/li>\n\u003Cli>The results are displayed in a dashboard with summary cards, charts, a prediction table, and CSV export.\u003C/li>\n\u003C/ol>\n\u003Ch2 id=\"lessons-learned\">Lessons learned\u003C/h2>\n\u003Cp>This project helped me understand the challenges of turning a machine learning experiment into a complete application. In particular, I gained practical experience in packet processing, network-flow feature extraction, data preprocessing, anomaly detection, and building a web interface around a machine learning pipeline.\u003C/p>\n",{"headings":872,"localImagePaths":893,"remoteImagePaths":894,"frontmatter":895,"imagePaths":896},[873,877,881,884,887,890],{"depth":874,"slug":875,"text":876},1,"overview","Overview",{"depth":878,"slug":879,"text":880},2,"development","Development",{"depth":878,"slug":882,"text":883},"challenges-and-limitations","Challenges and limitations",{"depth":878,"slug":885,"text":886},"what-it-does","What it does",{"depth":878,"slug":888,"text":889},"basic-workflow","Basic workflow",{"depth":878,"slug":891,"text":892},"lessons-learned","Lessons learned",[],[],{"title":865},[],"y86-disassembler",{"id":897,"data":899,"body":902,"filePath":903,"digest":904,"rendered":905},{"title":900,"link":901},"Y86 Disassembler","https://github.com/Vvorx/Y86-Disassembler","# Y86 Disassembler\r\n\r\nThis is one of the first projects that we had to do at University, it certainly gave me a better perspective on how computers operate underneath the high-level code we write.\r\n\r\n## What is Y86?\r\n\r\nThe Y86 instruction set architecture (ISA) is a simplified version of the x86 architecture, commonly used in computer architecture courses to illustrate key concepts. It features a smaller set of instructions, registers, and addressing modes than x86, making it easier to learn and understand. For more information on Y86, please refer to the textbook \"Computer Systems: A Programmer's Perspective\" by Randal E. Bryant and David R. O'Hallaron, which is the original source for the Y86 ISA.\r\n\r\n## Usage\r\n\r\nTo disassemble a Y86 machine code file, use the following command:\r\n\r\n```bash\r\n./y86-disassembler \u003Cinput_file>\r\n```\r\n\r\nReplace `\u003Cinput_file>` with the path to your Y86 machine code file.\r\n\r\n## Building\r\n\r\nTo compile the Y86 disassembler, you will need a C compiler such as `gcc`. Navigate to the directory containing the source code file `y86disassembler.c` and run the following command:\r\n\r\n```bash\r\ngcc -o y86-disassembler y86disassembler.c\r\n```\r\n\r\nThis will create an executable file named `y86-disassembler` in the current directory.\r\n\r\n## Features\r\n\r\nThe Y86 Disassembler supports a wide range of Y86 instructions, including:\r\n\r\n*   **Data Transfer:** `rrmovl`, `irmovl`, `rmmovl`, `mrmovl`, `pushl`, `popl`\r\n*   **Conditional Moves:** `cmovle`, `cmovl`, `cmove`, `cmovne`, `cmovge`, `cmovg`\r\n*   **Arithmetic/Logical Operations:** `addl`, `subl`, `andl`, `xorl`\r\n*   **Control Flow:** `jmp`, `jle`, `jl`, `je`, `jne`, `jge`, `jg`, `call`, `ret`\r\n*   **Miscellaneous:** `halt`, `nop`\r\n\r\nThe disassembler correctly decodes register operands and immediate values, including displacements for memory operations.\r\n\r\n## Example\r\n\r\nHere's an example of Y86 machine code and its corresponding disassembled output:\r\n\r\n**Input (e.g., in a file named `example.yo`):**\r\n\r\n```\r\n30F234120000\r\n2001\r\n00\r\n```\r\n\r\n**Command:**\r\n\r\n```bash\r\n./y86-disassembler example.yo\r\n```\r\n\r\n**Output:**\r\n\r\n```\r\nirmovl $4660, %edx\r\nrrmovl %eax, %ecx\r\nhalt\r\n```\r\n(Note: The immediate value `$4660` is the decimal representation of `0x1234`.)","src/content/projects/Y86-Disassembler.md","3901db6f63895e65",{"html":906,"metadata":907},"\u003Ch1 id=\"y86-disassembler\">Y86 Disassembler\u003C/h1>\n\u003Cp>This is one of the first projects that we had to do at University, it certainly gave me a better perspective on how computers operate underneath the high-level code we write.\u003C/p>\n\u003Ch2 id=\"what-is-y86\">What is Y86?\u003C/h2>\n\u003Cp>The Y86 instruction set architecture (ISA) is a simplified version of the x86 architecture, commonly used in computer architecture courses to illustrate key concepts. It features a smaller set of instructions, registers, and addressing modes than x86, making it easier to learn and understand. For more information on Y86, please refer to the textbook “Computer Systems: A Programmer’s Perspective” by Randal E. Bryant and David R. O’Hallaron, which is the original source for the Y86 ISA.\u003C/p>\n\u003Ch2 id=\"usage\">Usage\u003C/h2>\n\u003Cp>To disassemble a Y86 machine code file, use the following command:\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">./y86-disassembler\u003C/span>\u003Cspan style=\"color:#F97583\"> &lt;\u003C/span>\u003Cspan style=\"color:#9ECBFF\">input_fil\u003C/span>\u003Cspan style=\"color:#E1E4E8\">e\u003C/span>\u003Cspan style=\"color:#F97583\">&gt;\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Replace \u003Ccode>&lt;input_file&gt;\u003C/code> with the path to your Y86 machine code file.\u003C/p>\n\u003Ch2 id=\"building\">Building\u003C/h2>\n\u003Cp>To compile the Y86 disassembler, you will need a C compiler such as \u003Ccode>gcc\u003C/code>. Navigate to the directory containing the source code file \u003Ccode>y86disassembler.c\u003C/code> and run the following command:\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">gcc\u003C/span>\u003Cspan style=\"color:#79B8FF\"> -o\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> y86-disassembler\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> y86disassembler.c\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>This will create an executable file named \u003Ccode>y86-disassembler\u003C/code> in the current directory.\u003C/p>\n\u003Ch2 id=\"features\">Features\u003C/h2>\n\u003Cp>The Y86 Disassembler supports a wide range of Y86 instructions, including:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Data Transfer:\u003C/strong> \u003Ccode>rrmovl\u003C/code>, \u003Ccode>irmovl\u003C/code>, \u003Ccode>rmmovl\u003C/code>, \u003Ccode>mrmovl\u003C/code>, \u003Ccode>pushl\u003C/code>, \u003Ccode>popl\u003C/code>\u003C/li>\n\u003Cli>\u003Cstrong>Conditional Moves:\u003C/strong> \u003Ccode>cmovle\u003C/code>, \u003Ccode>cmovl\u003C/code>, \u003Ccode>cmove\u003C/code>, \u003Ccode>cmovne\u003C/code>, \u003Ccode>cmovge\u003C/code>, \u003Ccode>cmovg\u003C/code>\u003C/li>\n\u003Cli>\u003Cstrong>Arithmetic/Logical Operations:\u003C/strong> \u003Ccode>addl\u003C/code>, \u003Ccode>subl\u003C/code>, \u003Ccode>andl\u003C/code>, \u003Ccode>xorl\u003C/code>\u003C/li>\n\u003Cli>\u003Cstrong>Control Flow:\u003C/strong> \u003Ccode>jmp\u003C/code>, \u003Ccode>jle\u003C/code>, \u003Ccode>jl\u003C/code>, \u003Ccode>je\u003C/code>, \u003Ccode>jne\u003C/code>, \u003Ccode>jge\u003C/code>, \u003Ccode>jg\u003C/code>, \u003Ccode>call\u003C/code>, \u003Ccode>ret\u003C/code>\u003C/li>\n\u003Cli>\u003Cstrong>Miscellaneous:\u003C/strong> \u003Ccode>halt\u003C/code>, \u003Ccode>nop\u003C/code>\u003C/li>\n\u003C/ul>\n\u003Cp>The disassembler correctly decodes register operands and immediate values, including displacements for memory operations.\u003C/p>\n\u003Ch2 id=\"example\">Example\u003C/h2>\n\u003Cp>Here’s an example of Y86 machine code and its corresponding disassembled output:\u003C/p>\n\u003Cp>\u003Cstrong>Input (e.g., in a file named \u003Ccode>example.yo\u003C/code>):\u003C/strong>\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"plaintext\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>30F234120000\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>2001\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>00\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>\u003Cstrong>Command:\u003C/strong>\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">./y86-disassembler\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> example.yo\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>\u003Cstrong>Output:\u003C/strong>\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"plaintext\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>irmovl $4660, %edx\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>rrmovl %eax, %ecx\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>halt\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>(Note: The immediate value \u003Ccode>$4660\u003C/code> is the decimal representation of \u003Ccode>0x1234\u003C/code>.)\u003C/p>\n",{"headings":908,"localImagePaths":925,"remoteImagePaths":926,"frontmatter":927,"imagePaths":928},[909,910,913,916,919,922],{"depth":874,"slug":897,"text":900},{"depth":878,"slug":911,"text":912},"what-is-y86","What is Y86?",{"depth":878,"slug":914,"text":915},"usage","Usage",{"depth":878,"slug":917,"text":918},"building","Building",{"depth":878,"slug":920,"text":921},"features","Features",{"depth":878,"slug":923,"text":924},"example","Example",[],[],{"title":900,"link":901},[]]