---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection, type CollectionEntry } from "astro:content";

const posts = await getCollection("books");
---

<BaseLayout title="Bookshelf">
  <header>
    <h1>My Bookshelf</h1>
    <h1>WIP</h1>
    <hr>
  </header>
  <ol reversed>
    {posts.map((post: CollectionEntry<"books">) => (
      <li><a href={post.data.link}>{post.data.title}</a></li>
    ))}
  </ol>
</BaseLayout>

<style>
  a {
    font-size: 20px;
  }

</style>